{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Owlfice",
  "version": "0.2.3",
  "identifier": "com.owlfice.owlfice",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "야근불 · Owlfice",
        "width": 1280,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/LICENSE-MIT.txt",
      "../design/fonts/LICENSE-IBM-Plex.txt": "licenses/LICENSE-IBM-Plex.txt",
      "../design/fonts/LICENSE-Galmuri.txt": "licenses/LICENSE-Galmuri.txt"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Korean"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2RDQ5NjE1NDNEMTVBRTkKUldUcFd0RkRGWmJVZG1BWUFpM1dFN2VzeFlXNXV3bzdtYTJERlRicmFUL2M2ZVBGL3Y2M3RxWlcK",
      "endpoints": ["https://github.com/dbwk10317/owlfice/releases/latest/download/latest.json"]
    }
  }
}
